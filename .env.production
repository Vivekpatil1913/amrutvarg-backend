# Production config for https://amrutvarg.mahaamrut.org.in
# Committed to git — NO SECRETS HERE.
# Secrets go in .env.production.local on the server (gitignored); see
# .env.production.local.example. Values there override this file.

NODE_ENV=production
PORT=4000

# PostgreSQL (PGPASSWORD lives in .env.production.local)
PGHOST=localhost
PGPORT=5432
PGUSER=amrutvarg
PGDATABASE=amrutvarg_cms

# Session
SESSION_HOURS=8

# Sign-in protection: only wrong passwords count, never successful sign-ins.
# An account is paused for at most LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS
# wrong passwords from one IP; LOGIN_MAX_ATTEMPTS_PER_IP caps wrong passwords
# from one IP across all accounts. See src/config/env.js.
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_IP=100
LOGIN_LOCK_MINUTES=15

# The site sits behind CloudFront → nginx. Leave at 1 until the EC2 security
# group only admits CloudFront (prefix list
# com.amazonaws.global.cloudfront.origin-facing), then set 2 so rate limits see
# each visitor's real IP instead of a shared CloudFront edge IP.
TRUST_PROXY=1

# CORS — the public site and the /admin panel share one origin
ADMIN_ORIGIN=https://amrutvarg.mahaamrut.org.in
SITE_ORIGIN=https://amrutvarg.mahaamrut.org.in

# Uploads (relative to the backend folder)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Initial admin for `npm run db:setup:prod` (password lives in .env.production.local)
SEED_ADMIN_EMAIL=admin@mahaamrut.org.in
SEED_ADMIN_NAME=Admin
