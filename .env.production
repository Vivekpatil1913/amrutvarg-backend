# Production config for https://amrutvarg.mahaamrut.org.in
# Committed to git — NO SECRETS HERE.
# Secrets go in .env.production.local on the server (gitignored); see
# .env.production.local.example. Values there override this file.

NODE_ENV=production
PORT=4000

# PostgreSQL (PGPASSWORD lives in .env.production.local)
PGHOST=localhost
PGPORT=5432
PGUSER=amrutvarg
PGDATABASE=amrutvarg_cms

# Session
SESSION_HOURS=8

# Auth
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# CORS — the public site and the /admin panel share one origin
ADMIN_ORIGIN=https://amrutvarg.mahaamrut.org.in
SITE_ORIGIN=https://amrutvarg.mahaamrut.org.in

# Uploads (relative to the backend folder)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Initial admin for `npm run db:setup:prod` (password lives in .env.production.local)
SEED_ADMIN_EMAIL=admin@mahaamrut.org.in
SEED_ADMIN_NAME=Admin
