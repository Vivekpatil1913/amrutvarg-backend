NODE_ENV=development
PORT=4000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=amrutvarg_cms

# JWT (use a random 64+ char string in production)
JWT_SECRET=replace_with_long_random_secret

# CORS (comma-separated origins)
ADMIN_ORIGIN=http://localhost:5173
SITE_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Initial admin created by seed script
SEED_ADMIN_EMAIL=admin@amrutvarg.local
SEED_ADMIN_PASSWORD=ChangeMe@1234
SEED_ADMIN_NAME=Admin
