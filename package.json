{
  "name": "amrutvarg-backend",
  "version": "1.0.0",
  "description": "CMS backend for Amrutvarg programme website",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "db:migrate": "node migrations/migrate.js",
    "db:seed": "node seeds/seed.js",
    "db:setup": "node migrations/migrate.js && node seeds/seed.js",
    "db:migrate:prod": "NODE_ENV=production node migrations/migrate.js",
    "db:seed:prod": "NODE_ENV=production node seeds/seed.js",
    "db:setup:prod": "NODE_ENV=production node migrations/migrate.js && NODE_ENV=production node seeds/seed.js",
    "test": "node --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {}
}
