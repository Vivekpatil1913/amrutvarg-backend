# Copy to .env.production.local on the server and fill in. NEVER commit the copy.
#   cp .env.production.local.example .env.production.local && chmod 600 .env.production.local

# Generate with: openssl rand -hex 48
JWT_SECRET=

PGPASSWORD=

# Used only by `npm run db:setup:prod` / `db:seed:prod`. Change it after first login.
SEED_ADMIN_PASSWORD=
